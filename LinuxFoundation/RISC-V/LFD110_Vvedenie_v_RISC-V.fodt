     <text:p text:style-name="P4"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc1761_125099491" office:name="Расширения ISA" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">Расширения ISA<text:tab/>24</text:a></text:p>
