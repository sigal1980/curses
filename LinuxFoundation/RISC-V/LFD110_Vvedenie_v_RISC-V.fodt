     <text:index-title text:style-name="Sect1" text:name="Оглавление1_Head" text:protected="true">
      <text:p text:style-name="Contents_20_Heading">Оглавление</text:p>
     </text:index-title>
     <text:p text:style-name="P2"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc2_759769767" office:name="01. Информация о курсе" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">01. Информация о курсе<text:tab/>1</text:a></text:p>
     <text:p text:style-name="P3"><text:a xlink:type="simple" xlink:href="#__RefHeading___Toc4_759769767" office:name="Информация о курсе" text:style-name="Index_20_Link" text:visited-style-name="Index_20_Link">Информация о курсе<text:tab/>1</text:a></text:p>
