   <text:p text:style-name="Код">.word black</text:p>
   <text:p text:style-name="Код">.word blue</text:p>
   <text:p text:style-name="Код"/>
   <text:p text:style-name="Код"># столбец 8</text:p>
   <text:p text:style-name="Код">.word yellow</text:p>
