     </table:table-cell>
     <table:table-cell table:style-name="Символьные_5f_имена_5f_регистров_5f_RISC-V.A1" office:value-type="string">
      <text:p text:style-name="P56">Вызывающая функция</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell table:style-name="Символьные_5f_имена_5f_регистров_5f_RISC-V.A1" office:value-type="string">
